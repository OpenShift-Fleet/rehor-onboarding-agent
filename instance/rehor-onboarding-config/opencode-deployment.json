{
  "providers": [
    {
      "id": "rehor-openai",
      "npm": "@ai-sdk/openai",
      "name": "Rehor OpenAI Responses",
      "options": {
        "baseURL": "{env:REHOR_MODEL_PROXY_URL}",
        "apiKey": "{env:REHOR_MODEL_PROXY_TOKEN}"
      },
      "models": {
        "gpt-6.1-sol": {
          "name": "GPT-6.1 Sol",
          "reasoning": true,
          "options": {
            "reasoningEffort": "medium"
          }
        },
        "gpt-6-luna": {
          "name": "GPT-6 Luna",
          "reasoning": true,
          "options": {
            "reasoningEffort": "medium"
          }
        }
      }
    }
  ],
  "packages": [
    {
      "name": "@ai-sdk/openai",
      "version": "4.0.73"
    }
  ]
}
